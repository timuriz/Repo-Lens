# Gemini API key for AI codebase analysis — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: raises GitHub API limits for tree fetch (public repos work without it)
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: override the persistent analysis cache location (defaults to data/analysis-cache.sqlite)
# Only used in Node (local / long-running). On Cloudflare Workers L2 is skipped automatically.
# ANALYSIS_CACHE_PATH=data/analysis-cache.sqlite
